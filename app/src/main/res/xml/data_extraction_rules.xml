<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never upload user-selected Character Studio face textures to cloud backup -->
        <exclude domain="file" path="faces" />
        <exclude domain="file" path="faces/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="faces" />
        <exclude domain="file" path="faces/" />
    </device-transfer>
</data-extraction-rules>
